<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : vraies couleurs dynamiques du système (fond d'écran), au lieu
  du dégradé statique de drawable/widget_background.xml. Contrairement aux
  autres accents du widget (couleur d'un événement, pastille "aujourd'hui"),
  poussés par l'app via SharedPreferences et teintés à l'affichage, un fond en
  dégradé ne peut pas être teinté dynamiquement : teindre un drawable
  applique UNE seule couleur unie sur tout le drawable, ce qui aplatirait le
  dégradé. On lit donc directement la palette système ici.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@android:color/system_accent1_100"
        android:endColor="@android:color/system_accent1_10" />
    <corners android:radius="24dp" />
</shape>
