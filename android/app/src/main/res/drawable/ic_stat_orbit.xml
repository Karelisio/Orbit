<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône de la barre de notification : silhouette blanche plate uniquement
  (Android ignore les couleurs d'une icône de notif et ne garde que l'alpha),
  reprenant le motif "deux anneaux entrelacés" de l'icône de l'app (voir
  drawable-v24/ic_launcher_foreground.xml et OrbitLogo.tsx), mis à l'échelle
  dans le viewport 24x24 attendu pour une icône de notif.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M9,12 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M5.8,12 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />
</vector>
