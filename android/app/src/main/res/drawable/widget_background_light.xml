<?xml version="1.0" encoding="utf-8"?>
<!--
  Fond clair de la tuile, en dégradé (haut -> bas) comme le fond de l'app
  (voir .app-shell dans global.css : primary-container -> background). Sur
  Android 12+, drawable-v31/widget_background_light.xml prend le dessus avec
  les vraies teintes dynamiques du système ; ce dégradé statique reste le
  repli pour les appareils plus anciens.
  centerColor = startColor pour garder la teinte sur toute la première
  moitié : le blanc de endColor n'apparaît que dans le dernier tiers.

  Choisi en code (OrbitWidgetTheme.isDarkTheme(), voir les providers), pas
  par la résolution jour/nuit d'Android : le thème système du téléphone peut
  différer du thème choisi dans l'app (Réglages > Thème), et c'est ce dernier
  qui colore le texte — fond et texte doivent donc venir de la même décision
  pour ne jamais devenir illisibles l'un sur l'autre.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#EADDFF"
        android:centerColor="#EADDFF"
        android:endColor="#F7F2FA" />
    <corners android:radius="24dp" />
</shape>
