<?xml version="1.0" encoding="utf-8"?>
<!--
  Fond sombre de la tuile (voir widget_background_light.xml pour le
  raisonnement). En pratique inatteignable en dessous d'Android 12
  (OrbitWidgetTheme.isDarkTheme() renvoie toujours false sans lecture
  dynamique), conservé pour la symétrie des ressources.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#4F378B"
        android:endColor="#341F5C" />
    <corners android:radius="24dp" />
</shape>
