<?xml version="1.0" encoding="utf-8"?>
<!--
  Base unie du fond de tuile, teintée au runtime avec la couleur
  primary-container de l'app (OrbitWidgetTheme.applyTileBackground).

  C'est volontairement l'app qui fournit la couleur, et non la palette
  système @android:color/system_accent1_* utilisée auparavant : cette
  dernière suit le thème du constructeur (HyperOS, One UI...) et pouvait
  donner un fond marron pendant que l'app, elle, tirait sa palette de la
  couleur dominante du fond d'écran. Les deux divergeaient visiblement.

  Le <solid> explicite est indispensable : un <shape> sans lui se remplit
  d'une couleur opaque arbitraire dès qu'on lui applique un tint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#EADDFF" />
    <corners android:radius="24dp" />
</shape>
