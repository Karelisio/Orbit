<?xml version="1.0" encoding="utf-8"?>
<!--
  Base unie du fond de tuile. Sa couleur vient de la teinte posée sur la vue
  qui l'affiche (android:backgroundTint="@color/widget_dyn_primary_container"
  dans les layouts des widgets) : la couleur système dynamique, résolue et
  repeinte par le lanceur lui-même (values-v31 / values-night-v31) — les
  mêmes tons que l'app (DynamicColorPlugin), donc jamais de divergence.
  OrbitWidgetTheme.applyTileBackground ne la remplace que si une image de
  thème est choisie dans l'app (palette poussée par WidgetSync.tsx). Le
  violet ci-dessous n'est qu'un repli, jamais visible une fois teinté.

  Le <solid> explicite est indispensable : un <shape> sans lui se remplit
  d'une couleur opaque arbitraire dès qu'on lui applique un tint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#EADDFF" />
    <corners android:radius="24dp" />
</shape>
