<?xml version="1.0" encoding="utf-8"?>
<!-- Jour de règles seulement PRÉVU (projection du cycle, pas encore
     enregistré dans Wenn) : simple contour de la même couleur fixe que
     widget_period_dot.xml (point plein = règles enregistrées), comme dans le
     calendrier de l'app (Calendar.tsx, .dot-period.predicted). Pas de
     teinte appliquée ici ; le <solid> transparent explicite reste là par
     prudence (un <shape> sans <solid> se remplit dès qu'on le teinte). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#B3261E" />
</shape>
