<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ en thème clair : couleurs système dynamiques (dérivées du fond
  d'écran par Android lui-même), même mapping de tons que
  DynamicColorPlugin.java côté app, pour que widgets et app affichent
  exactement la même teinte. Le qualificatif "night" étant plus spécifique
  que "v31" seul, le thème sombre a son propre fichier
  (values-night-v31/widget_dynamic_colors.xml) plutôt que de retomber ici.
-->
<resources>
    <color name="widget_dyn_primary">@android:color/system_accent1_600</color>
    <color name="widget_dyn_on_primary">@android:color/system_accent1_0</color>
    <color name="widget_dyn_primary_container">@android:color/system_accent1_100</color>
    <color name="widget_dyn_on_primary_container">@android:color/system_accent1_900</color>
    <color name="widget_dyn_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_dyn_on_surface_variant">@android:color/system_neutral2_700</color>
</resources>
