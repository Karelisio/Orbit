<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante sombre du dégradé (voir drawable/widget_background.xml). Le texte
  de la tuile suit la palette Material You de l'app (donc clair en sombre) —
  le fond doit rester sombre sur toute sa hauteur pour garder le contraste.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#4F378B"
        android:endColor="#341F5C" />
    <corners android:radius="24dp" />
</shape>
