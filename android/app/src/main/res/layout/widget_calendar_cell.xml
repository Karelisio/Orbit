<?xml version="1.0" encoding="utf-8"?>
<!-- Une case de jour : le numéro, une rangée de petits points pour les
     règles (Wenn, désactivable) et les tâches en attente ce jour-là, et sous
     eux les pastilles des événements du jour (jusqu'à 2, empilées, voir
     widget_calendar_event_chip.xml et WidgetSync.tsx — ajoutées
     dynamiquement dans widget_cell_events, vide/absent s'il n'y en a pas).
     Le fond en quadrillage discret marque la limite de la case ; le clic
     ouvre l'app sur ce jour précis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="0.5dp"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:paddingLeft="1dp"
    android:paddingRight="1dp">

    <TextView
        android:id="@+id/widget_cell_day"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_cell_dots_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_cell_period_dot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/widget_period_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_cell_task_dot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_task_dot"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_cell_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
