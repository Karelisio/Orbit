<?xml version="1.0" encoding="utf-8"?>
<!--
  Grille construite en vraies vues (une par jour), plus en Bitmap dessiné :
  un grand widget produisait un bitmap de plusieurs dizaines de Mo, au-delà
  de la limite autorisée pour un widget — updateAppWidget() levait alors une
  exception et la tuile restait vide et non cliquable. Les vues natives
  restent nettes à toute taille et gardent un texte de taille constante.

  widget_root est un FrameLayout (et non directement le LinearLayout de
  contenu) pour séparer le fond (widget_bg, une simple ImageView non
  cliquable) du clic plein-tuile : appliquer le fond en code sur la même
  vue que celle qui porte à la fois le clic plein-tuile ET les cases de jour
  cliquables (voir OrbitCalendarWidgetProvider.java) a déjà fait perdre le
  clic précis sur un jour sur au moins un lanceur Android — les deux
  responsabilités sont maintenant sur des vues distinctes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_solid"
        android:backgroundTint="@color/widget_dyn_primary_container"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_cal_prev"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/widget_dyn_on_primary_container"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cal_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_dyn_on_primary_container"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cal_next"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/widget_dyn_on_primary_container"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Repère "aujourd'hui" : jour de la semaine + quantième, toujours celui
         du jour réel, même en naviguant vers un autre mois avec ‹ ›. -->
    <TextView
        android:id="@+id/widget_cal_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_dyn_on_surface_variant"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/widget_cal_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/widget_cal_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
