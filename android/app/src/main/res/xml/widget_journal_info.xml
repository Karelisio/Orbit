<?xml version="1.0" encoding="utf-8"?>
<!-- Une seule ligne de la grille par défaut : voir widget_combined_info.xml
     pour le détail des deux règles de taille (targetCell* et minWidth/Height)
     et pourquoi maxResizeWidth/Height est volontairement absent. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/widget_journal"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_journal_description" />
